generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  STUDENT
  PLACEMENT_OFFICER
  ADMIN
}

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  passwordHash String
  role         UserRole @default(STUDENT)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  student Student?
}

model Department {
  id        Int       @id @default(autoincrement())
  name      String    @unique
  code      String?   @unique
  students  Student[]
  createdAt DateTime  @default(now())
}

model Student {
  id                 Int       @id @default(autoincrement())
  userId             Int       @unique
  departmentId       Int
  registrationNumber String    @unique
  fullName           String
  phone              String?
  dateOfBirth        DateTime?
  gender             String?
  address            String?
  city               String?
  state              String?
  program            String
  batchYear          Int
  currentSemester    Int?
  bio                String?
  linkedinUrl        String?
  githubUrl          String?
  portfolioUrl       String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  user        User                  @relation(fields: [userId], references: [id])
  department  Department            @relation(fields: [departmentId], references: [id])
  skills      StudentSkill[]
  projects    Project[]
  internships Internship[]
  performance SemesterPerformance[]
  resumes     Resume[]
  activities  StudentActivity[]
  sports      StudentSport[]
  awards      StudentAward[]
}

model Category {
  id     Int     @id @default(autoincrement())
  name   String  @unique
  skills Skill[]
}

model Domain {
  id     Int     @id @default(autoincrement())
  name   String  @unique
  skills Skill[]
}

model Skill {
  id         Int    @id @default(autoincrement())
  name       String @unique
  categoryId Int?
  domainId   Int?

  category Category? @relation(fields: [categoryId], references: [id])
  domain   Domain?   @relation(fields: [domainId], references: [id])

  studentSkills    StudentSkill[]
  projectSkills    ProjectSkill[]
  internshipSkills InternshipSkill[]
}

model StudentSkill {
  studentId Int
  skillId   Int
  level     String?
  createdAt DateTime @default(now())

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  skill   Skill   @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([studentId, skillId])
}

model Project {
  id          Int       @id @default(autoincrement())
  studentId   Int
  title       String
  description String?
  role        String?
  startDate   DateTime?
  endDate     DateTime?
  projectUrl  String?
  createdAt   DateTime  @default(now())

  student Student        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  skills  ProjectSkill[]
}

model ProjectSkill {
  projectId Int
  skillId   Int

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  skill   Skill   @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([projectId, skillId])
}

model Internship {
  id             Int       @id @default(autoincrement())
  studentId      Int
  companyName    String
  role           String
  description    String?
  startDate      DateTime?
  endDate        DateTime?
  certificateUrl String?
  createdAt      DateTime  @default(now())

  student Student           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  skills  InternshipSkill[]
}

model InternshipSkill {
  internshipId Int
  skillId      Int

  internship Internship @relation(fields: [internshipId], references: [id], onDelete: Cascade)
  skill      Skill      @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([internshipId, skillId])
}

model SemesterPerformance {
  id           Int      @id @default(autoincrement())
  studentId    Int
  semester     Int
  cgpa         Float?
  attendance   Float?
  backlogs     Int      @default(0)
  marksheetUrl String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, semester])
}

model Resume {
  id         Int      @id @default(autoincrement())
  studentId  Int
  fileName   String
  fileUrl    String
  isDefault  Boolean  @default(false)
  uploadedAt DateTime @default(now())

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model StudentActivity {
  id          Int      @id @default(autoincrement())
  studentId   Int
  title       String
  description String?
  createdAt   DateTime @default(now())

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model StudentSport {
  id          Int      @id @default(autoincrement())
  studentId   Int
  sportName   String
  achievement String?
  createdAt   DateTime @default(now())

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model StudentAward {
  id             Int       @id @default(autoincrement())
  studentId      Int
  title          String
  issuer         String?
  awardDate      DateTime?
  certificateUrl String?
  createdAt      DateTime  @default(now())

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

//Placement Officer
//Campus drive tables

enum DriveStatus {
  UPCOMING
  REGISTRATION_OPEN
  COMPLETED
  CANCELLED
}

enum JobType {
  FULL_TIME
  PART_TIME
  INTERNSHIP
  CONTRACT
}

enum DriveDepartment {
  CSE
  IT
  ECE
  EEE
  MECH
  CIVIL
}

enum Degree {
  BTECH
  BE
  MCA
  MSC
  MTECH
}

enum SelectionStage {
  APTITUDE
  TECHNICAL
  HR
  GROUP_DISCUSSION
  ONLINE_TEST
  INTERVIEW
  OFFER
}

model Company {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  website     String?
  logoUrl     String?  @map("logo_url")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  campusDrives CampusDrive[]

  @@index([name])
  @@map("companies")
}

model CampusDrive {
  id                   Int               @id @default(autoincrement())
  companyId            Int               @map("company_id")
  title                String
  description          String?
  driveDateTime        DateTime          @map("drive_date_time")
  registrationDeadline DateTime?         @map("registration_deadline")
  status               DriveStatus       @default(UPCOMING)
  jobType              JobType           @map("job_type")
  departments          DriveDepartment[]
  eligibleDegrees      Degree[]
  minimumCgpa          Float?            @map("minimum_cgpa")
  backlogsAllowed      Boolean           @default(false) @map("backlogs_allowed")
  location             String?
  salary               String?
  createdAt            DateTime          @default(now()) @map("created_at")
  updatedAt            DateTime          @updatedAt @map("updated_at")

  company Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  roles   DriveRole[]

  @@index([companyId])
  @@index([driveDateTime])
  @@index([status])
  @@map("campus_drives")
}

model DriveRole {
  id             Int      @id @default(autoincrement())
  driveId        Int      @map("drive_id")
  title          String
  description    String?
  requiredSkills String[] @map("required_skills")
  vacancies      Int      @default(1)
  salary         String?
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  campusDrive CampusDrive @relation(fields: [driveId], references: [id], onDelete: Cascade)

  @@index([driveId])
  @@map("drive_roles")
}
